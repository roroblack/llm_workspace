# Gemini API 키를 입력합니다.
GOOGLE_API_KEY=여기에_GEMINI_API_KEY_입력

# OpenAI API 키를 입력합니다.
OPENAI_API_KEY=여기에_OPENAI_API_KEY_입력

# OpenAI 모델명을 지정합니다.
OPENAI_MODEL=gpt-4o-mini

# Gemini 모델명을 지정합니다.
GEMINI_MODEL=gemini-2.5-flash

# Gemini 2.5 계열의 thinking 토큰 사용량을 줄입니다. 필요하면 값을 늘리세요.
GEMINI_THINKING_BUDGET=0

# Gemini 임베딩 모델명입니다. common.py 호환용입니다.
GEMINI_EMBED_MODEL=models/gemini-embedding-001
