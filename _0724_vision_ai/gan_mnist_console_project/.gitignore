# PyCharm 프로젝트 개인 설정 파일을 Git에서 제외합니다.
.idea/

# Python 가상환경 디렉터리를 Git에서 제외합니다.
.venv/

# Python 바이트코드 캐시 디렉터리를 제외합니다.
__pycache__/

# 컴파일된 Python 파일을 제외합니다.
*.pyc

# 자동으로 내려받는 MNIST 원본 데이터를 제외합니다.
data/

# 학습 과정에서 생성되는 이미지, 모델, 그래프를 제외합니다.
outputs/

# 운영체제에서 생성할 수 있는 임시 파일을 제외합니다.
.DS_Store
Thumbs.db
