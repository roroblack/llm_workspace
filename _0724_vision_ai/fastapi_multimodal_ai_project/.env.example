# FastAPI 디버그 모드입니다.
DEBUG=true

# 이미지 캡셔닝 모델입니다. 기존 설정을 유지합니다.
CAPTION_MODEL_ID=Salesforce/blip-image-captioning-base

# 이미지 캡셔닝 영한 번역과 이미지 생성 한영 번역에 함께 사용하는 NLLB 모델입니다.
TRANSLATION_MODEL_ID=facebook/nllb-200-distilled-600M

# 프롬프트 이해력과 구도 표현이 향상된 Stable Diffusion XL 모델입니다.
DIFFUSION_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

# CPU에서도 실행 가능한 Whisper 모델입니다. 기존 설정을 유지합니다.
WHISPER_MODEL_ID=openai/whisper-small

# 업로드 최대 크기(MB)입니다.
MAX_UPLOAD_SIZE_MB=15

# SDXL 권장 기본 생성 설정입니다.
DEFAULT_INFERENCE_STEPS=40
DEFAULT_GUIDANCE_SCALE=8.0
DIFFUSION_IMAGE_SIZE=1024
