# 이 파일을 .env 로 복사해서 사용한다. (.env 는 커밋 금지)

# --- 모델 선택 ---
# 감성분석: SST-2 파인튜닝 DistilBERT (약 260MB)
CLASSIFICATION_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# 요약: distilbart-cnn-6-6(약 800MB, 가벼움) / sshleifer/distilbart-cnn-12-6(약 1.2GB)
#      / facebook/bart-large-cnn(약 1.6GB, 품질 최상)
SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-6-6

# 번역: NLLB-200 distilled 600M (약 2.4GB, 다국어)
#      디스크가 부족하면 언어쌍 전용 경량 모델로 교체:
#      TRANSLATION_MODEL=Helsinki-NLP/opus-mt-tc-big-en-ko   (약 800MB)
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M

# NLLB 언어 코드 (FLORES-200). Marian 모델 사용 시 무시됨
TRANSLATION_SRC_LANG=eng_Latn
TRANSLATION_TGT_LANG=kor_Hang

# --- 실행 환경 ---
# -1 = CPU, 0 이상 = GPU index
DEVICE=-1

# HF 모델 캐시 폴더. 비워두면 ~/.cache/huggingface 사용.
# C 드라이브가 좁으면 다른 드라이브를 지정한다. 예: D:/hf_cache
# HF_HOME=

# 서버 기동 시 미리 로딩할 태스크 (쉼표 구분). 지정한 것만 첫 요청 지연이 사라진다.
#   (빈 값)                        = 전부 lazy 로딩
#   classification,summarization  = 둘만 미리 로딩, 번역은 lazy
#   all                           = 3종 전부
#
# 주의: all 은 fp32 가중치 합계가 약 3.5GB다. 가용 메모리가 부족하면
#       OpenBLAS 할당 실패로 기동이 죽는다(가용 3.6GB 환경에서 실패 확인).
#       메모리가 빠듯하면 자주 쓰는 태스크만 골라 지정할 것.
PRELOAD_MODELS=

# --- 한계값 ---
MAX_INPUT_CHARS=20000
MAX_BATCH_SIZE=32
SUMMARY_CHUNK_TOKENS=700
