# 애플리케이션의 표시 이름입니다.
APP_NAME=FastAPI RunPod LLM Evaluation

# 로컬에서는 mock, RunPod에서는 transformers로 변경합니다.
INFERENCE_BACKEND=mock

# 기반 모델의 Hugging Face 이름 또는 로컬 경로입니다.
BASE_MODEL_PATH=Qwen/Qwen2.5-0.5B-Instruct

# 병합된 파인튜닝 모델의 로컬 경로 또는 Hugging Face 이름입니다.
FINE_TUNED_MODEL_PATH=/workspace/models/merged_model

# 모델 장치 배치 방식입니다.
DEVICE_MAP=auto

# auto, float16, bfloat16, float32 중 하나를 사용합니다.
TORCH_DTYPE=auto

# 4비트 양자화 사용 여부입니다.
LOAD_IN_4BIT=false

# 기본 최대 생성 토큰 수입니다.
MAX_NEW_TOKENS=256

# 평가 데이터 파일입니다.
EVALUATION_FILE=data/evaluation.jsonl

# 평가 결과 저장 디렉터리입니다.
OUTPUT_DIR=outputs

# 서버 주소와 포트입니다.
HOST=0.0.0.0
PORT=8000

# Hugging Face 비공개 모델을 사용할 때만 입력합니다.
HF_TOKEN=
