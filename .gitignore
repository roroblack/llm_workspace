# --- 소스만 푸시: 아래는 제외 (환경/모델/아카이브/대용량 데이터/로그) ---
# 시크릿(.env) — 절대 커밋 금지 (.env.example만 허용)
.env
**/.env
!**/.env.example

# 가상환경·캐시
venv/
env/
.ipynb_checkpoints/
node_modules/
lightning_logs/

# 학습된 모델·바이너리 산출물
*.safetensors
*.pt
*.pth
*.ckpt
*.bin
*.gguf
*.pkl
*.h5
*.onnx
*.msgpack
*.db
*.sqlite

# 아카이브(자기백업 zip·192MB openjdk zip 등)
*.zip
*.tar
*.tar.gz
*.gz
*.7z
*.rar

# 대용량 데이터셋
**/aclImdb/
**/ratings_train.txt
**/ratings_test.txt

# 폰트·로그·JVM 크래시
*.ttf
*.otf
*.log
hs_err_pid*

# 산출 모델 저장 폴더
models/
**/models/*.pt
**/models/*.pkl

# 단, app/models/ 는 Pydantic 스키마 소스이므로 추적한다 (산출물 아님).
# 하위 .py 만 되살리고 __pycache__ 등 산출물은 계속 무시한다.
!**/app/models/
!**/app/models/*.py

# 작업 문서(계획서·보고서) — 소스만 푸시
plans/
**/plans/
reports/
**/reports/
